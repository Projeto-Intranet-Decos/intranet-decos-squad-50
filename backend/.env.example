# Opcional e só para desenvolvimento: o backend já lê o .env da raiz, e o que estiver aqui vale
# por cima dele. Em produção use apenas o .env da raiz.
# A URL do banco é montada destas partes (não existe DATABASE_URL).
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=intranet
POSTGRES_USER=intranet
POSTGRES_PASSWORD=troque-esta-senha
# Gere com: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=troque-este-segredo
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=7
# Lista JSON, ex: ["http://localhost:5173"]
CORS_ORIGINS=[]

MINIO_ENDPOINT=localhost:9000
MINIO_USER=intranet
MINIO_PASSWORD=troque-esta-senha
MINIO_BUCKET=intranet
# true só se o MinIO estiver atrás de HTTPS
MINIO_SECURE=false
MAX_UPLOAD_SIZE_MB=50

# E-mail (GER-19). "console" só escreve o e-mail no log do backend; "resend" envia de verdade.
EMAIL_PROVIDER=console
EMAIL_FROM=Intranet do Hospital <nao-responda@exemplo.com.br>
FRONTEND_URL=http://localhost:5173
RESEND_API_KEY=
INVITE_HOURS=72
PASSWORD_RESET_MINUTES=60

# Só para o bootstrap do primeiro superadmin (scripts/criar_superadmin.py);
# se ficar em branco, o script pergunta no terminal.
SUPERADMIN_NAME=Admin
SUPERADMIN_EMAIL=admin@example.com
SUPERADMIN_PASSWORD=senha123
