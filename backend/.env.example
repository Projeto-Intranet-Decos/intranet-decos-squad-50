# Opcional: o backend já lê o .env da raiz, e o que estiver aqui vale por cima dele.
# A URL do banco é montada destas partes (não existe DATABASE_URL).
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=intranet
POSTGRES_USER=intranet
POSTGRES_PASSWORD=troque-esta-senha
# Gere com: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=troque-este-segredo
ACCESS_TOKEN_MINUTOS=30
REFRESH_TOKEN_DIAS=7
# Lista JSON, ex: ["http://localhost:5173"]
ORIGENS_CORS=[]

MINIO_ENDPOINT=localhost:9000
MINIO_USUARIO=intranet
MINIO_SENHA=troque-esta-senha
MINIO_BUCKET=intranet
# true só se o MinIO estiver atrás de HTTPS
MINIO_SEGURO=false
TAMANHO_MAXIMO_UPLOAD_MB=50

# E-mail (GER-19). "console" só escreve o e-mail no log do backend; "smtp" envia de verdade.
EMAIL_PROVEDOR=console
# Na Brevo, precisa ser um remetente verificado ou de um domínio autenticado.
EMAIL_REMETENTE=Intranet do Hospital <nao-responda@exemplo.com.br>
# Endereço do frontend como o colaborador acessa: base dos links dos e-mails.
URL_FRONTEND=http://localhost:5173
# SMTP da Brevo (Configurações > SMTP & API > SMTP). Usuário é o "login SMTP" e a senha é uma
# "chave SMTP" gerada lá, não a chave de API (xkeysib-...). 587 usa STARTTLS; 465 usa TLS direto.
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORTA=587
SMTP_USUARIO=
SMTP_SENHA=
CONVITE_HORAS=72
REDEFINICAO_SENHA_MINUTOS=60

# Só para o bootstrap do primeiro superadmin (scripts/criar_superadmin.py);
# se ficar em branco, o script pergunta no terminal.
SUPERADMIN_NOME=Admin
SUPERADMIN_EMAIL=admin@example.com
SUPERADMIN_SENHA=senha123
