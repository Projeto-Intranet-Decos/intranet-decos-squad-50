// Produção no Cloudflare: um Worker serve o build do frontend (assets estáticos) e repassa /api/*
// ao backend, que roda num Cloudflare Container a partir do mesmo backend/Dockerfile do compose.
// O banco é o Postgres externo (Supabase) e os arquivos ficam no R2, pela API S3 dele.
// Passo a passo em cloudflare/README.md.
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "intranet",
	"main": "src/index.ts",
	"compatibility_date": "2026-11-06",
	"observability": { "enabled": true },

	// A zona projetodecos.online está no Cloudflare; com custom_domain, o deploy cria os registros
	// DNS e o certificado. Nenhum dos dois nomes pode ter registro A/CNAME próprio na zona.
	// Sem isto, ter routes desliga o intranet.davignascimento.workers.dev.
	"workers_dev": true,
	// Cada versão ganharia uma URL pública própria, mas todas usam o mesmo container e o banco de
	// produção; não há o que pré-visualizar.
	"preview_urls": false,
	"routes": [
		{ "pattern": "projetodecos.online", "custom_domain": true },
		{ "pattern": "www.projetodecos.online", "custom_domain": true }
	],

	// O frontend chama a API em /api (frontend/src/lib/api.ts). Só esse caminho passa pelo Worker;
	// o resto é asset, e rota desconhecida cai no index.html (react-router resolve).
	"assets": {
		"directory": "../frontend/dist",
		"binding": "ASSETS",
		"not_found_handling": "single-page-application",
		"run_worker_first": ["/api/*"]
	},

	"containers": [
		{
			"class_name": "Backend",
			// O contexto do build é a pasta do Dockerfile; o backend/.dockerignore tira .env e .venv.
			"image": "../backend/Dockerfile",
			// 1/4 de vCPU, 1 GiB de RAM, 4 GB de disco.
			"instance_type": "basic",
			"max_instances": 1
		}
	],
	"durable_objects": {
		"bindings": [{ "name": "BACKEND", "class_name": "Backend" }]
	},
	"exports": {
		"Backend": { "type": "durable-object", "storage": "sqlite" }
	},

	// Configuração do backend que não é segredo. Os segredos (lista em src/index.ts) vão com
	// `npx wrangler secret put <NOME>` e nunca entram neste arquivo.
	"vars": {
		"POSTGRES_PORT": "5432",
		"POSTGRES_DB": "postgres",
		"ACCESS_TOKEN_MINUTES": "30",
		"REFRESH_TOKEN_DAYS": "7",
		"AWS_ENDPOINT_URL": "https://fad69c06e78fbe7b540d9cf8220c78b3.r2.cloudflarestorage.com",
		"AWS_S3_BUCKET_NAME": "intranet",
		"AWS_DEFAULT_REGION": "auto",
		// O Worker aceita até 100 MB por requisição; o limite do backend fica abaixo disso.
		"MAX_UPLOAD_SIZE_MB": "50",
		"EMAIL_PROVIDER": "resend",
		"EMAIL_FROM": "Intranet do Hospital <nao-responda@contato.projetodecos.online>",
		"FRONTEND_URL": "https://projetodecos.online",
		"INVITE_HOURS": "72",
		"PASSWORD_RESET_MINUTES": "60"
	}
}
