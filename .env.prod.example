# Modelo do .env de produção (docker-compose.prod.yml). No servidor: cp .env.prod.example .env
# Banco e armazenamento são externos: nenhum dos dois roda no compose de produção.

# Postgres externo. A URL é montada destas partes (não existe DATABASE_URL).
POSTGRES_HOST=banco.exemplo.com.br
POSTGRES_PORT=5432
POSTGRES_DB=intranet
POSTGRES_USER=intranet
POSTGRES_PASSWORD=troque-esta-senha
# prefer (padrão) usa TLS se o banco oferecer; require exige.
PGSSLMODE=prefer

# Armazenamento externo compatível com S3 (AWS S3, Cloudflare R2, MinIO próprio...).
# MINIO_ENDPOINT é só o host, sem https:// e sem o bucket.
MINIO_ENDPOINT=s3.sa-east-1.amazonaws.com
MINIO_BUCKET=intranet
# Access Key ID e Secret Access Key
MINIO_USER=troque-esta-chave
MINIO_PASSWORD=troque-este-segredo
# true para HTTPS
MINIO_SECURE=true

# Gere com: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=troque-este-segredo
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=7

# E-mail (GER-22). Em produção use resend; console só escreve o e-mail no log do backend.
EMAIL_PROVIDER=resend
EMAIL_FROM=Intranet do Hospital <nao-responda@exemplo.com.br>
RESEND_API_KEY=
INVITE_HOURS=72
PASSWORD_RESET_MINUTES=60
# Endereço público do frontend, base dos links dos e-mails.
FRONTEND_URL=https://intranet.exemplo.com.br

FRONTEND_PORT=80
