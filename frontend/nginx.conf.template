server {
    # PORT vem do Railway; no compose fica o padrão 80 do Dockerfile.
    listen ${PORT};
    listen [::]:${PORT};
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # Upload de documentos e de capa/anexos de aviso passa por aqui. A criação de aviso manda
    # capa e todos os anexos numa requisição só, então o total precisa caber neste limite
    # (o frontend confere antes de enviar). Tem que bater com MAX_UPLOAD_SIZE_MB do backend.
    client_max_body_size 50m;

    # As variáveis de ambiente API_URL e NGINX_LOCAL_RESOLVERS são preenchidas pela imagem do
    # nginx ao subir (ver Dockerfile). Com o endereço numa variável, o nginx resolve o nome a cada 10 s em vez
    # de só na partida, então continua achando o backend depois de ele ser recriado com outro IP.
    resolver ${NGINX_LOCAL_RESOLVERS} valid=10s;

    # O frontend chama a API em /api (ver src/lib/api.ts); o prefixo é removido
    # antes de repassar ao backend, que expõe as rotas sem ele.
    location /api/ {
        set $api ${API_URL};
        rewrite ^/api/(.*)$ /$1 break;
        proxy_pass $api;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Prefix /api;
    }

    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        try_files $uri =404;
    }

    # SPA: qualquer rota desconhecida cai no index.html (react-router resolve).
    location / {
        add_header Cache-Control "no-cache";
        try_files $uri $uri/ /index.html;
    }
}
