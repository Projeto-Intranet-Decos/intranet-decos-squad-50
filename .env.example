# Só vale na criação do volume do banco: trocar depois não muda a senha de um banco que já existe.
POSTGRES_DB=intranet
POSTGRES_USER=intranet
POSTGRES_PASSWORD=troque-esta-senha
# Onde o backend acha o banco quando roda FORA do Docker (no compose é sempre banco:5432).
# A porta acompanha PORTA_BANCO.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

MINIO_ROOT_USER=intranet
MINIO_ROOT_PASSWORD=troque-esta-senha
MINIO_BUCKET=intranet

# Gere com: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=troque-este-segredo
ACCESS_TOKEN_MINUTOS=30
REFRESH_TOKEN_DIAS=7

# E-mail (GER-19). "console" só escreve o e-mail no log do backend; "smtp" envia de verdade.
EMAIL_PROVEDOR=console
# Na Brevo, precisa ser um remetente verificado ou de um domínio autenticado.
EMAIL_REMETENTE=Intranet do Hospital <nao-responda@exemplo.com.br>
# Endereço do frontend como o colaborador acessa: base dos links dos e-mails.
URL_FRONTEND=http://localhost:8080
# SMTP da Brevo (Configurações > SMTP & API > SMTP). Usuário é o "login SMTP" e a senha é uma
# "chave SMTP" gerada lá, não a chave de API (xkeysib-...). 587 usa STARTTLS; 465 usa TLS direto.
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORTA=587
SMTP_USUARIO=
SMTP_SENHA=
CONVITE_HORAS=72
REDEFINICAO_SENHA_MINUTOS=60

# Portas expostas no host (mude se já estiverem em uso)
PORTA_FRONTEND=8080
PORTA_BACKEND=8000
PORTA_BANCO=5432
PORTA_MINIO=9000
PORTA_MINIO_CONSOLE=9001
