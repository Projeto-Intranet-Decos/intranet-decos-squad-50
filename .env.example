POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=intranet
POSTGRES_USER=intranet
POSTGRES_PASSWORD=troque-esta-senha

MINIO_ROOT_USER=intranet
MINIO_ROOT_PASSWORD=troque-esta-senha
# Para o backend fora do Docker. No compose, o backend recebe MINIO_ROOT_USER/MINIO_ROOT_PASSWORD,
# exceto no deploy com S3 externo (docker-compose.prod.yml, ver README): aí valem MINIO_ENDPOINT,
# MINIO_USER, MINIO_PASSWORD, MINIO_BUCKET e MINIO_SECURE, e as MINIO_ROOT_* devem sair do .env.
MINIO_USER=intranet
MINIO_PASSWORD=troque-esta-senha
MINIO_BUCKET=intranet
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# Gere com: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=troque-este-segredo
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=7

# E-mail (GER-22). "console" só escreve o e-mail no log do backend; "resend" envia de verdade.
EMAIL_PROVIDER=console
EMAIL_FROM=Intranet do Hospital <nao-responda@exemplo.com.br>
RESEND_API_KEY=
INVITE_HOURS=72
PASSWORD_RESET_MINUTES=60
FRONTEND_URL=http://localhost:8080

API_PORT=8000
FRONTEND_PORT=8080
