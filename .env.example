POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=intranet
POSTGRES_USER=intranet
POSTGRES_PASSWORD=troque-esta-senha

MINIO_ROOT_USER=intranet
MINIO_ROOT_PASSWORD=troque-esta-senha
# Só para o backend fora do Docker. No compose, o backend recebe MINIO_ROOT_USER/MINIO_ROOT_PASSWORD.
AWS_ACCESS_KEY_ID=intranet
AWS_SECRET_ACCESS_KEY=troque-esta-senha
AWS_S3_BUCKET_NAME=intranet
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# Gere com: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=troque-este-segredo
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=7

# E-mail (GER-22). "console" só escreve o e-mail no log do backend; "resend" envia de verdade.
EMAIL_PROVIDER=console
EMAIL_FROM=Intranet do Hospital <nao-responda@exemplo.com.br>
RESEND_API_KEY=
INVITE_HOURS=72
PASSWORD_RESET_MINUTES=60
FRONTEND_URL=http://localhost:8080

API_PORT=8000
FRONTEND_PORT=8080
